# JobHunter Orchestration Service — Environment Variables
# Copy to .env and fill in real values before running.

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://jobhunter:jobhunter@localhost:5432/jobhunter
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ── API ───────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# ── Security ──────────────────────────────────────────────────────────────────
SECRET_KEY_APPROVAL=changeme-32-char-secret-key-here

# ── Rate limits ───────────────────────────────────────────────────────────────
MAX_APPLICATIONS_PER_DAY=10
MAX_VARIANTS_PER_SESSION=15
MAX_VARIANTS_TOTAL=50

# ── Service paths ─────────────────────────────────────────────────────────────
SCRAPER_OUTPUT_DIR=./output/final
AI_RESUME_DIR=./resumes/
REGISTRY_PATH=./registries/jobs.json

# ── LLM ───────────────────────────────────────────────────────────────────────
LLM_PRIMARY_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Mail ──────────────────────────────────────────────────────────────────────
SENDGRID_API_KEY=
MAIL_SENDER_EMAIL=apply@jobhunter.app

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=changeme-jwt-secret-key-minimum-32chars!
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=15
REFRESH_TOKEN_EXPIRY_DAYS=30
MIN_PASSWORD_LENGTH=8
APPROVAL_TOKEN_SECRET=changeme-32-char-secret-key-here

# ── MinIO ─────────────────────────────────────────────────────────────────────
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=jobhunter-resumes
MINIO_SECURE=false
