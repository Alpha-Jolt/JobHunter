# JobHunter Orchestration Service — Environment Variables
# Copy to .env and fill in real values before running.

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://jobhunter:jobhunter@localhost:5432/jobhunter
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
# Set to true in production to skip create_all and rely solely on Alembic migrations
USE_ALEMBIC_MIGRATIONS=false

# ── API ───────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# ── Security ──────────────────────────────────────────────────────────────────
SECRET_KEY_APPROVAL=changeme-32-char-secret-key-here

# ── Rate limits ───────────────────────────────────────────────────────────────
MAX_APPLICATIONS_PER_DAY=10
MAX_VARIANTS_PER_SESSION=15
MAX_VARIANTS_TOTAL=50

# ── Service paths ─────────────────────────────────────────────────────────────
SCRAPER_OUTPUT_DIR=./output/final
AI_RESUME_DIR=./resumes/
REGISTRY_PATH=./registries/jobs.json

# ── LLM ───────────────────────────────────────────────────────────────────────
LLM_PRIMARY_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Mail ──────────────────────────────────────────────────────────────────────
SENDGRID_API_KEY=
MAIL_SENDER_EMAIL=apply@jobhunter.app

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=changeme-jwt-secret-key-minimum-32chars!
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=15
REFRESH_TOKEN_EXPIRY_DAYS=30
MIN_PASSWORD_LENGTH=8
APPROVAL_TOKEN_SECRET=changeme-32-char-secret-key-here
COOKIE_SECURE=false

# ── MinIO ─────────────────────────────────────────────────────────────────────
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=jobhunter-resumes
MINIO_AVATAR_BUCKET_NAME=jobhunter-avatars
MINIO_SECURE=false
MINIO_EXTERNAL_ENDPOINT=app.example.com
MINIO_EXTERNAL_SECURE=true

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── OpenTelemetry ─────────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
