# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=change-this-in-production-it-must-be-very-long
ADMIN_EMAIL=admin@example.com
# Argon2 hash for "admin" -> $argon2id$v=19$m=65536,t=3,p=4$iV5eXwYf1yEaP0+X+3Bbwg$kX8j6+5v2r8HkP5yP1X4yH9x6q3t4v7y9w2u3y1z4x5w
ADMIN_PASSWORD_HASH="$argon2id$v=19$m=65536,t=3,p=4$iV5eXwYf1yEaP0+X+3Bbwg$kX8j6+5v2r8HkP5yP1X4yH9x6q3t4v7y9w2u3y1z4x5w"

# Auth
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# External connections
POSTGRES_URL=postgresql+asyncpg://jobhunter:jobhunter@postgres:5432/jobhunter
REDIS_URL=redis://redis:6379/0
FRONTEND_URL=http://localhost:5001
