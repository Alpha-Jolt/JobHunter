# Environment — copy to .env and fill in values

# --- Scraper ---
HEADLESS=true
BROWSER_POOL_SIZE=3
SCRAPER_TIMEOUT_MS=30000
DEBUG_SCREENSHOTS=false
DEV_MODE=true

# --- Rate Limiting ---
INDEED_RATE_LIMIT=1.0
NAUKRI_RATE_LIMIT=0.5

# --- Proxy ---
PROXY_LIST=
PROXY_STRATEGY=round_robin
PROXY_FALLBACK_TO_DIRECT=true

# --- Retry ---
MAX_RETRIES=3
RETRY_BASE_DELAY=2.0
RETRY_MAX_DELAY=60.0

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_DIR=logs

# --- Sentry (optional) ---
SENTRY_DSN=

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Output ---
OUTPUT_DIR=output
# Supported formats: json, csv
OUTPUT_FORMATS=
USE_REGISTRY=false
REGISTRY_PATH=registries/jobs.json

# --- Database ---
USE_DATABASE=false
DATABASE_URL=postgresql+asyncpg://jobhunter:jobhunter@localhost:5432/jobhunter
DB_POOL_SIZE=5

# --- Hunter.io ---
HUNTER_API_KEY=
HUNTER_RATE_LIMIT=0.5

# --- Apify ---
APIFY_API_TOKEN=
APIFY_RATE_LIMIT=2.0
APIFY_RUN_TIMEOUT_SECONDS=300
APIFY_POLL_INTERVAL_SECONDS=5

# --- Pipeline ---
PAGES_PER_SEARCH=1

# --- Company Discovery (Module 1) ────────────────────────────────────────────
# Optional GitHub Personal Access Token for org discovery.
# Without token: 60 requests/hour. With token: 5,000 requests/hour.
GITHUB_TOKEN=

# Primary search engine for Discovery Mode (duckduckgo or bing)
SEARCH_ENGINE_PRIMARY=duckduckgo

# Max DuckDuckGo queries per session before a 5-minute pause
COMPANY_DISCOVERY_MAX_QUERIES_PER_SESSION=15

# Rate limit for enrichment page requests (requests per second, 0.33 = 1 req/3s)
COMPANY_ENRICHMENT_RATE_LIMIT_RPS=0.33

# Enrichment page request timeout in seconds
COMPANY_ENRICHMENT_TIMEOUT_SECONDS=30

# How many days before a company's email data is considered stale and re-crawled
COMPANY_EMAIL_REFRESH_DAYS=30

# --- Career Page Scraper (Module 2) ──────────────────────────────────────────
# Rate limit for career page requests (1 request per second per domain)
CAREER_PAGE_RATE_LIMIT_RPS=1.0

# Rate limit for sitemap-driven crawls (lower priority batch operation)
CAREER_SITEMAP_RATE_LIMIT_RPS=0.33

# HTTP 429 backoff start time in seconds
CAREER_PAGE_BACKOFF_SECONDS=60

# --- data.gov.in open API (MSME UDYAM bulk importer) ─────────────────────────
# Public sample key — works for open resources with no registration required.
# Replace with your own key from data.gov.in for higher rate limits.
DATAGOV_API_KEY=579b464db66ec23bdd000001ccd3946e44ce4aax7209ff7b23ac571b
DATAGOV_MSME_RESOURCE_ID=8bc8ae56-84cf-4128-a0a6-1be12028dfa7
# Max pages to fetch per bootstrap run (500 records/page). 100 = 50,000 records.
DATAGOV_MSME_MAX_PAGES=100
DATAGOV_PAGE_SIZE=500

# --- Candidate Email Generation (post-enrichment) ─────────────────────────────
# DNS MX lookup timeout in seconds. Failures (timeout/no MX) discard the domain.
CANDIDATE_EMAIL_MX_TIMEOUT=5
