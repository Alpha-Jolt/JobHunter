# Grafana Authentication
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=your_secure_password_here

# Note: Prometheus, Loki, and Tempo do not natively support built-in authentication
# in their open-source versions. They are intended to run on isolated internal networks
# (like the jobhunter_network) and should not have their ports exposed to the public internet
# in production without a reverse proxy (like Nginx) handling auth.
