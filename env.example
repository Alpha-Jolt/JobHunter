# JobHunter — single root .env for all services
# Usage:
#   cp env.example .env
#   # edit .env if needed, then:
#   docker compose -f DOCKER-COMPOSE.yml up -d --build
#
# VPS: CI copies this file to /docker/JobHunter/.env, then overlays
# non-empty GitHub Production secrets (same key names).

# ++++++++++++++++   PUBLIC / COMPOSE (webapp + admin build args) +++++++++++
# same-origin = browser uses /api on app.myjobhunter.in (no CORS). Next.js proxies to INTERNAL_API_URL.
NEXT_PUBLIC_API_BASE_URL=same-origin
NEXT_PUBLIC_APP_URL=https://app.myjobhunter.in
NEXT_PUBLIC_ADMIN_API_URL=https://admin-api.myjobhunter.in
NEXT_PUBLIC_MINIO_URL=https://app.myjobhunter.in
INTERNAL_API_URL=http://jobhunter-api:8000
ADMIN_API_INTERNAL_URL=http://admin-api:8003

# Browser origins allowed to call the orchestration API (comma-separated)
CORS_ORIGINS=https://app.myjobhunter.in,http://localhost:3000,http://localhost:5173

# Postgres container credentials (must match DATABASE_URL / POSTGRES_URL)
POSTGRES_USER=jobhunter
POSTGRES_PASSWORD=jobhunter
POSTGRES_DB=jobhunter

# ++++++++++++++++   ADMIN ENV +++++++++++++++++++++++++++++++++++++

# Application
ENVIRONMENT=production
LOG_LEVEL=INFO
SECRET_KEY=9e23154dc4b1fc2698ba2a15db2594945aca750b92b6b2c38f090fde5c54537a3fd1db9e616effdc1f071ab167d7daa5ffba5d59c8acf9a70850d64fabd7e576
ADMIN_EMAIL=sysadmin@myjobhunter.in
# password: $Sup3r-Ad;m1n&2026
ADMIN_PASSWORD_HASH="$$argon2id$$v=19$$m=65536,t=3,p=4$$yhaNDpxrzNqxzgmy64/Bcg$$Kjwpnc9sqYgmIg2n4RxQ6Yltbvu8TK101AN4F8hGv3c"

# Auth
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# External connections
POSTGRES_URL=postgresql+asyncpg://jobhunter:jobhunter@postgres:5432/jobhunter
REDIS_URL=redis://redis:6379/0
FRONTEND_URL=https://admin.myjobhunter.in
SCRAPER_LOG_PATH=../scraper/logs/scraper.log


#+++++++++++++++++++++++ AI ENGINE ENV +++++++++++++++++++++++++++++

# Application
APP_NAME=JobHunter-AIEngine
ENVIRONMENT=production

# LLM Provider Keys (set via GitHub Production secrets or local .env — do not commit real keys)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
GROK_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
NVIDIA_NIM=

# LLM Settings
LLM_PRIMARY_PROVIDER=openrouter
LLM_MAX_RETRIES=3
LLM_TIMEOUT_SECONDS=60

# Variant Budget
MAX_VARIANTS_TOTAL=15
MAX_VARIANTS_PER_SESSION=5

# Paths
PATH_SCRAPER_OUTPUT_DIR=output/final
PATH_AI_OUTPUT_DIR=ai_output
PATH_PROMPTS_DIR=ai_engine/features/llm/prompting/prompts
PATH_VARIANT_REGISTRY_PATH=ai_output/variant_registry.json

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Approval Token Secret (JSON keyring for rotation)
APPROVAL_KEYS={"k1":"df26adb18d43097fe352d3d6cbb7b441e8636c2073c84272089a575ded173c97"}
APPROVAL_ACTIVE_KEY=k1


#+++++++++++++++++++++++ OBSERVABILITY ENV +++++++++++++++++++++++++++++
# Grafana Authentication
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=Admin123!

# Note: Prometheus, Loki, and Tempo do not natively support built-in authentication
# in their open-source versions. They are intended to run on isolated internal networks
# (like the jobhunter_network) and should not have their ports exposed to the public internet
# in production without a reverse proxy (like Nginx) handling auth.



#+++++++++++++++++++++++ ORCHESTRATION ENV +++++++++++++++++++++++++++++

# JobHunter Orchestration — Environment
DATABASE_URL=postgresql+asyncpg://jobhunter:jobhunter@postgres:5432/jobhunter
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
USE_ALEMBIC_MIGRATIONS=true
ALEMBIC_MIGRATIONS=true

API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

SECRET_KEY_APPROVAL=8903ca8dd988daba33c73b87d35a158bbb492b995f734b2ccce6332eb607d13c
APPROVAL_TOKEN_SECRET=c2c6d868a7d865116edb59ebf37d5161ccc86db919408d398ff8f341ba4f577d

APPROVAL_KEYS={"k1":"df26adb18d43097fe352d3d6cbb7b441e8636c2073c84272089a575ded173c97"}
APPROVAL_ACTIVE_KEY=k1

JWT_SECRET=a0dc7ded9eb9f7deda2caabb1e55355be33f13678cdf7df3f75a0d31d19ba4c6
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=15
REFRESH_TOKEN_EXPIRY_DAYS=30
MIN_PASSWORD_LENGTH=8
COOKIE_SECURE=true
# Share refresh_token across app.myjobhunter.in + api.myjobhunter.in
COOKIE_DOMAIN=.myjobhunter.in

MAX_APPLICATIONS_PER_DAY=10
MAX_VARIANTS_PER_SESSION=15
MAX_VARIANTS_TOTAL=50

SCRAPER_OUTPUT_DIR=./output/final
AI_RESUME_DIR=./resumes/
REGISTRY_PATH=./registries/jobs.json

LLM_PRIMARY_PROVIDER=openrouter
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

SENDGRID_API_KEY=
MAIL_SENDER_EMAIL=apply@myjobhunter.in
MAIL_BRIDGE_URL=https://app.myjobhunter.in/mailbridge
MAIL_BRIDGE_API_KEY=dev-key
MAILBRIDGE_WEBHOOK_SECRET=
MAILBRIDGE_WEBHOOK_ID=

# ── MinIO ─────────────────────────────────────────────────────────────────────
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=jobhunter-resumes
MINIO_AVATAR_BUCKET_NAME=jobhunter-avatars
MINIO_SECURE=false
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENABLED=true
MINIO_EXTERNAL_ENDPOINT=app.myjobhunter.in
MINIO_EXTERNAL_SECURE=true

# ── OpenTelemetry ─────────────────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

INTERNAL_API_KEY=e00a244fa5e85b0c05deb5dac63cfc5044d87231521a71330d5a70290604e2e1


#+++++++++++++++++++++++ SCRAPER ENV +++++++++++++++++++++++++++++

# --- Scraper ---
HEADLESS=true
BROWSER_POOL_SIZE=3
SCRAPER_TIMEOUT_MS=30000
DEBUG_SCREENSHOTS=false
DEV_MODE=true

# --- Rate Limiting ---
INDEED_RATE_LIMIT=1.0
NAUKRI_RATE_LIMIT=0.5

# --- Proxy ---
PROXY_LIST=
PROXY_STRATEGY=round_robin
PROXY_FALLBACK_TO_DIRECT=true

# --- Retry ---
MAX_RETRIES=3
RETRY_BASE_DELAY=2.0
RETRY_MAX_DELAY=60.0

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_DIR=logs

# --- Sentry (optional) ---
SENTRY_DSN=

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Output ---
OUTPUT_DIR=output
OUTPUT_FORMATS=
USE_REGISTRY=false

# --- Database ---
USE_DATABASE=true
DATABASE_URL=postgresql+asyncpg://jobhunter:jobhunter@postgres:5432/jobhunter
DB_POOL_SIZE=5

# --- Pipeline ---
PAGES_PER_SEARCH=5

# --- data.gov.in open API (MSME UDYAM bulk importer) ─────────────────────────
DATAGOV_API_KEY=
DATAGOV_MSME_RESOURCE_ID=8b68ae56-84cf-4728-a0a6-1be11028dea7
DATAGOV_MSME_MAX_PAGES=3
DATAGOV_PAGE_SIZE=500
