{
  "info": {
    "name": "Mail-Bridge API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "2.0.0"
  },
  "variable": [
    {
      "key": "auth_url",
      "value": "{{AUTH_URL}}"
    },
    {
      "key": "credentials_url",
      "value": "{{CREDENTIALS_URL}}"
    },
    {
      "key": "emails_url",
      "value": "{{EMAILS_URL}}"
    },
    {
      "key": "templates_url",
      "value": "{{TEMPLATES_URL}}"
    },
    {
      "key": "health_url",
      "value": "{{HEALTH_URL}}"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "credential_id",
      "value": ""
    },
    {
      "key": "template_id",
      "value": ""
    },
    {
      "key": "email_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register (valid)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "pm.test('has token', () => { const b = pm.response.json(); pm.expect(b.token).to.be.a('string'); pm.collectionVariables.set('token', b.token); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{auth_url}}/auth/register",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"user@example.com\",\"password\":\"Password123!\",\"workspace_name\":\"My Team\"}"
            }
          }
        },
        {
          "name": "Register (duplicate email → 409)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 409', () => pm.response.to.have.status(409));",
                  "pm.test('EMAIL_EXISTS code', () => pm.expect(pm.response.json().error.code).to.eql('EMAIL_EXISTS'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{auth_url}}/auth/register",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"user@example.com\",\"password\":\"Password123!\",\"workspace_name\":\"My Team\"}"
            }
          }
        },
        {
          "name": "Login (valid)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('has token', () => { const b = pm.response.json(); pm.expect(b.token).to.be.a('string'); pm.collectionVariables.set('token', b.token); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{auth_url}}/auth/login",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"user@example.com\",\"password\":\"Password123!\"}"
            }
          }
        },
        {
          "name": "Login (wrong password → 401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{auth_url}}/auth/login",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"user@example.com\",\"password\":\"wrong\"}"
            }
          }
        },
        {
          "name": "Refresh token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('has new token', () => pm.expect(pm.response.json().token).to.be.a('string'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{auth_url}}/auth/refresh",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"token\":\"{{token}}\"}"
            }
          }
        }
      ]
    },
    {
      "name": "Credentials",
      "item": [
        {
          "name": "Add SMTP (valid)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "pm.test('has credential_id', () => { const b = pm.response.json(); pm.expect(b.credential_id).to.be.a('string'); pm.collectionVariables.set('credential_id', b.credential_id); });",
                  "pm.test('no encrypted_value', () => pm.expect(pm.response.json().encrypted_value).to.be.undefined);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{credentials_url}}/api/credentials/smtp",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"from_email\":\"me@example.com\",\"host\":\"smtp.example.com\",\"port\":587,\"secure\":false,\"user\":\"me@example.com\",\"pass\":\"app-password\"}"
            }
          }
        },
        {
          "name": "Add SMTP (missing fields → 400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 400', () => pm.response.to.have.status(400));",
                  "pm.test('INVALID_PAYLOAD', () => pm.expect(pm.response.json().error.code).to.eql('INVALID_PAYLOAD'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{credentials_url}}/api/credentials/smtp",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"from_email\":\"me@example.com\"}"
            }
          }
        },
        {
          "name": "List credentials",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('is array', () => pm.expect(pm.response.json().credentials).to.be.an('array'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{credentials_url}}/api/credentials",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ]
          }
        },
        {
          "name": "Test credential",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{credentials_url}}/api/credentials/{{credential_id}}/test",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ]
          }
        },
        {
          "name": "Delete credential",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "url": "{{credentials_url}}/api/credentials/{{credential_id}}",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "Emails",
      "item": [
        {
          "name": "Send email (inline html)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 202', () => pm.response.to.have.status(202));",
                  "pm.test('status queued', () => { const b = pm.response.json(); pm.expect(b.status).to.eql('queued'); pm.collectionVariables.set('email_id', b.email_id); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{emails_url}}/api/emails/send",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"credential_id\":\"{{credential_id}}\",\"to_email\":\"recipient@example.com\",\"subject\":\"Hello {{name}}\",\"html\":\"<p>Hi {{name}}</p>\",\"variables\":{\"name\":\"John\"}}"
            }
          }
        },
        {
          "name": "Send email (with template_id)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 202 or 404', () => pm.expect([202, 404]).to.include(pm.response.code));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{emails_url}}/api/emails/send",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"credential_id\":\"{{credential_id}}\",\"to_email\":\"recipient@example.com\",\"template_id\":\"{{template_id}}\",\"variables\":{\"name\":\"John\"}}"
            }
          }
        },
        {
          "name": "Send email (missing credential → 400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{emails_url}}/api/emails/send",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"to_email\":\"x@y.com\",\"subject\":\"Hi\",\"html\":\"<p>Hi</p>\"}"
            }
          }
        },
        {
          "name": "List emails (paginated)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('has emails array', () => pm.expect(pm.response.json().emails).to.be.an('array'));",
                  "pm.test('has total', () => pm.expect(pm.response.json().total).to.be.a('number'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{emails_url}}/api/emails?page=1&limit=10",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ]
          }
        },
        {
          "name": "Get email by id",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('has email_id', () => pm.expect(pm.response.json().email.email_id).to.be.a('string'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{emails_url}}/api/emails/{{email_id}}",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "Templates",
      "item": [
        {
          "name": "Create template",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "pm.test('has template_id', () => { pm.collectionVariables.set('template_id', pm.response.json().template.template_id); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{templates_url}}/api/templates",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"Welcome\",\"subject\":\"Welcome {{name}}\",\"html\":\"<p>Hi {{name}}</p>\",\"variables\":[\"name\"]}"
            }
          }
        },
        {
          "name": "List templates",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('is array', () => pm.expect(pm.response.json().templates).to.be.an('array'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{templates_url}}/api/templates",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ]
          }
        },
        {
          "name": "Update template",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "url": "{{templates_url}}/api/templates/{{template_id}}",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"Welcome Updated\"}"
            }
          }
        },
        {
          "name": "Delete template",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "url": "{{templates_url}}/api/templates/{{template_id}}",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /health",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('status ok', () => pm.expect(pm.response.json().status).to.eql('ok'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{health_url}}/health"
          }
        },
        {
          "name": "GET /health/ready",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200 or 503', () => pm.expect([200, 503]).to.include(pm.response.code));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{health_url}}/health/ready"
          }
        }
      ]
    }
  ]
}