# Application Environment
NODE_ENV=

# -----------------------------------------Database-----------------------------------------
# POSTGRES_DB: Choose a name for your Postgres database
POSTGRES_DB=

# POSTGRES_USER: Choose a username for your Postgres database
POSTGRES_USER=

# POSTGRES_PASSWORD: Generate a secure random password (Use `openssl rand -base64 32`)
POSTGRES_PASSWORD=

# DATABASE_URL: Construct using the format postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}
DATABASE_URL=

# Redis (self-hosted)
REDIS_URL=

# -----------------------------------------Auth-----------------------------------------
# JWT_SECRET: Generate a secure random string (minimum 32 characters) (Use `openssl rand -hex 32`)
JWT_SECRET=

# JWT_EXPIRES_IN: Set the expiration time for JWT tokens (e.g., '24h', '7d')
JWT_EXPIRES_IN=


# ──────────────────────────────────────────────────────────
# BUSL License Key
# Free (Personal Use):       https://mail-bridge.in/license
# Enterprise: legal@myjobhunter.in
# ──────────────────────────────────────────────────────────
MAIL_BRIDGE_LICENSE_KEY=
# ─────────────────────────────────────────────────────────────
# API Key  (for REST API authentication by external callers, e.g. JobHunter)
# Generated via: POST /auth/api-keys  (after registering a workspace)
# Starts with: sk_ (prod) or sk_test_ (non-prod)
# This is NOT the same as MAIL_BRIDGE_LICENSE_KEY above.
# ─────────────────────────────────────────────────────────────
MAIL_BRIDGE_API_KEY=

# -----------------------------------------Credential Encryption-----------------------------------------
# CREDENTIAL_MASTER_KEY: Generate a 64-character hex string (32 bytes) (Use `openssl rand -hex 32`)
CREDENTIAL_MASTER_KEY=

# -----------------------------------------Gmail OAuth-----------------------------------------
# optional — only needed for Gmail provider
# GMAIL_CLIENT_ID: Create a project in Google Cloud Console, configure OAuth consent, and create OAuth client ID credentials.
GMAIL_CLIENT_ID=

# GMAIL_CLIENT_SECRET: Generated alongside the GMAIL_CLIENT_ID in Google Cloud Console.
GMAIL_CLIENT_SECRET=

# GMAIL_REDIRECT_URI: The authorized redirect URI set in your Google Cloud Console OAuth client.
GMAIL_REDIRECT_URI=
# GMAIL_PUBSUB_TOPIC: Google Cloud Pub/Sub topic for Gmail inbound push notifications.
# Format: projects/YOUR_GCP_PROJECT_ID/topics/YOUR_TOPIC_NAME
# Grant publish rights to gmail-api-push@system.gserviceaccount.com on the topic.
# Leave empty to disable inbound Gmail push (outbound send still works).
GMAIL_PUBSUB_TOPIC=

# -----------------------------------------Outlook OAuth-----------------------------------------
# optional — only needed for Outlook provider
# OUTLOOK_CLIENT_ID: Register an application in Azure Active Directory (Microsoft Entra ID).
OUTLOOK_CLIENT_ID=

# OUTLOOK_CLIENT_SECRET: Create a new client secret in your Azure AD application's "Certificates & secrets".
OUTLOOK_CLIENT_SECRET=

# OUTLOOK_REDIRECT_URI: The redirect URI configured in your Azure AD application's authentication settings.
OUTLOOK_REDIRECT_URI=

# OUTLOOK_TENANT_ID: The Directory (tenant) ID of your Azure AD app, or 'common' for multi-tenant.
OUTLOOK_TENANT_ID=

# -----------------------------------------Email batch limit-----------------------------------------
# BATCH_MAX_SIZE: Set a number for the maximum batch size for sending emails
BATCH_MAX_SIZE=

# -----------------------------------------Logging-----------------------------------------
# LOG_LEVEL: Choose the logging level ('debug', 'info', 'warn', 'error')
LOG_LEVEL=


# -----------------------------------------FRONTEND_URL-----------------------------------------
# Public URL of the Mail-Bridge console (OAuth redirects).
# VPS: https://app.myjobhunter.in/mailbridge
FRONTEND_URL=

# -----------------------------------------API WebHook URL-----------------------------------------
# Server-side gateway URL for the Next.js BFF (Docker internal).
# VPS: http://gateway:3009   (NOT the public https URL)
API_GATEWAY_URL=

# Next.js basePath when hosted under a subpath (VPS: /mailbridge)
NEXT_PUBLIC_BASE_PATH=/mailbridge

# -----------------------------------------Service Ports-----------------------------------------
# Set these to the ports you want to expose on your host machine
AUTH_PORT=
CREDENTIALS_PORT=
EMAILS_PORT=
TEMPLATES_PORT=
ADMIN_PORT=
HEALTH_PORT=
DASHBOARD_PORT=
WEBHOOKS_PORT=
GATEWAY_PORT=
WEBAPP_PORT=
WEBSITE_PORT=